# ==========================================
# LinkForge - Global Environment Configuration
# ==========================================

# Backend Configuration
NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Database (MongoDB)
# Local development default or Docker service name
MONGODB_URI=mongodb://localhost:27017/linkforge

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Redis cache TTL in seconds for URL redirects (e.g., 86400 = 24 hours)
REDIS_CACHE_TTL=86400

# Authentication (JWT)
# Generate a strong 64-byte random secret for production: `openssl rand -hex 64`
JWT_SECRET=linkforge-super-secure-jwt-secret-key-replace-in-production-min32chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=linkforge-cookie-signing-secret-key-replace-in-production

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SHORT_BASE_URL=http://localhost:5000
